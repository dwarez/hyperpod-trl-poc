diff --git a/recipes_collection/recipes/fine-tuning/trl/trl-grpo-rlvr-qwen-3-0-dot-6b-lora-smoke.yaml b/recipes_collection/recipes/fine-tuning/trl/trl-grpo-rlvr-qwen-3-0-dot-6b-lora-smoke.yaml
new file mode 100644
index 0000000..f77895e
--- /dev/null
+++ b/recipes_collection/recipes/fine-tuning/trl/trl-grpo-rlvr-qwen-3-0-dot-6b-lora-smoke.yaml
@@ -0,0 +1,49 @@
+display_name: Qwen 3 0.6B GRPO RLVR with LoRA (TRL, smoke test)
+version: 0.1.0
+instance_types: ["ml.g6e.12xlarge", "ml.g5.12xlarge"]
+
+run:
+  name: trl-grpo-rlvr-qwen-3-0-dot-6b-lora-smoke
+  model_type: trl
+  results_dir: ${base_results_dir}/${.name}
+
+trainer:
+  num_nodes: 1
+  devices: 4
+
+training_config:
+  algorithm: grpo
+  args:
+    model_name_or_path: Qwen/Qwen3-0.6B
+    dtype: bfloat16
+    dataset_name: /opt/ml/input/data/train
+    dataset_train_split: train
+    reward_funcs: [accuracy_reward]
+    chat_template_kwargs:
+      enable_thinking: false
+
+    use_peft: true
+    lora_r: 32
+    lora_alpha: 64
+    lora_target_modules: all-linear
+
+    learning_rate: 1.0e-5
+    beta: 0.001
+    num_generations: 4
+    max_completion_length: 256
+    per_device_train_batch_size: 4
+    gradient_accumulation_steps: 1
+    # TRL sizes vLLM's max_num_seqs as per_device_train_batch_size x steps_per_generation x TP;
+    # below 8, vLLM crashes on H100 during CUDA graph capture (see README findings).
+    steps_per_generation: 2
+    max_steps: 10
+
+    use_vllm: true
+    vllm_mode: colocate
+    vllm_gpu_memory_utilization: 0.3
+    vllm_max_model_length: 768
+
+    bf16: true
+    logging_steps: 1
+    report_to: none
+    save_strategy: "no"
diff --git a/recipes_collection/recipes/fine-tuning/trl/trl-grpo-rlvr-qwen-3-8b-lora.yaml b/recipes_collection/recipes/fine-tuning/trl/trl-grpo-rlvr-qwen-3-8b-lora.yaml
new file mode 100644
index 0000000..991c5c5
--- /dev/null
+++ b/recipes_collection/recipes/fine-tuning/trl/trl-grpo-rlvr-qwen-3-8b-lora.yaml
@@ -0,0 +1,56 @@
+display_name: Qwen 3 8B GRPO RLVR Fine-Tuning with LoRA (TRL)
+version: 0.1.0
+instance_types: ["ml.p5.48xlarge", "ml.p4de.24xlarge"]
+
+run:
+  name: trl-grpo-rlvr-qwen-3-8b-lora
+  model_type: trl
+  results_dir: ${base_results_dir}/${.name}
+
+trainer:
+  num_nodes: 1
+  devices: 8
+
+# Hyperparameters mirror recipes_collection/recipes/fine-tuning/qwen/verl-grpo-rlvr-qwen-3-8b-lora.yaml
+training_config:
+  algorithm: grpo
+  args:
+    model_name_or_path: Qwen/Qwen3-8B
+    dtype: bfloat16
+    dataset_name: /opt/ml/input/data/train
+    dataset_train_split: train
+    reward_funcs: [accuracy_reward]
+    chat_template_kwargs:
+      enable_thinking: false
+
+    use_peft: true
+    lora_r: 32
+    lora_alpha: 64
+    lora_target_modules: all-linear
+
+    learning_rate: 1.0e-5
+    lr_scheduler_type: constant
+    beta: 0.001
+    epsilon: 0.2
+    epsilon_high: 0.2
+    loss_type: dapo
+    num_generations: 8
+    max_completion_length: 1024
+    temperature: 1.0
+    per_device_train_batch_size: 2
+    gradient_accumulation_steps: 16
+    steps_per_generation: 64
+    num_train_epochs: 2
+
+    use_vllm: true
+    vllm_mode: colocate
+    vllm_gpu_memory_utilization: 0.6
+    vllm_tensor_parallel_size: 2
+    vllm_max_model_length: 1536
+
+    bf16: true
+    gradient_checkpointing: true
+    logging_steps: 1
+    report_to: tensorboard
+    save_steps: 20
+    seed: 42
